# Unity generated / machine-local
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Never ignore the Kiro directory - it is a submission requirement.
# .kiro/  <-- deliberately absent

# Unity meta backup files
*.meta.bak
*_BackupThisFolder_ButDontShipItWithYourGame/

# Asset Store / imported tooling artifacts
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*

# IDE and autogenerated project files
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Plastic / version control metadata
.plastic/
.plastic_off/
.plastic.*/

# WebGL publish output IS committed - GitHub Pages serves it to judges.
# Only the per-app build logs are noise.
docs/build-webgl/**/build-*.log

# Unity's own Build/ rule above matches at any depth, which silently swallowed
# docs/build-webgl/<app>/Build/ - the folder holding the .data, .wasm and loader
# that the page actually needs. Re-include it explicitly.
!docs/build-webgl/**/Build/
!docs/build-webgl/**/Build/**

# Large intermediates Unity drops next to a WebGL build
docs/build-webgl/**/*.pdb
docs/build-webgl/**/Build/UnityLoader.js.map

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Crash reports
sysinfo.txt
crashlytics-build.properties
